# StickerHub backend environment variables

PORT=4000
# Comma-separated production origins allowed by CORS (shop + admin).
# Leave empty in dev. Example:
# ALLOWED_ORIGINS=https://stickerhub.in,https://admin.stickerhub.in
ALLOWED_ORIGINS=
CLIENT_URL=https://stickerhub.in

# Admin panel access key (sent as the x-admin-key header). Use a long random value.
ADMIN_KEY=change-me-to-a-long-random-string

# JWT secrets (use long random values in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Database (Neon Postgres)
DATABASE_URL=postgresql://neondb_owner:xxxx@ep-xxxx.neon.tech/neondb

# Email (Resend) — verify your domain in Resend for production delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@stickerhub.in
RESEND_FROM_NAME=StickerHub
RESEND_REPLY_TO=support@stickerhub.in
# Public storefront URL used in email links
SHOP_URL=https://stickerhub.in

# Razorpay (use LIVE keys for production)
# Get them at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# Cloudflare R2 image storage (for admin product image uploads)
# Create a bucket + API token in the Cloudflare dashboard, and enable a public URL.
# If these are left empty, the admin still works via pasted image URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stickerhub-images
# The bucket's public URL (R2.dev dev URL or your own CDN domain), no trailing slash.
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
